# Bu dosyayı ".env.local" adıyla kopyalayıp değerleri doldurun. .env.local GitHub'a gitmez.
# Supabase → Project Settings → API sayfasından alın.
NEXT_PUBLIC_SUPABASE_URL=https://PROJE-KODU.supabase.co
# "anon public" anahtarı (yeni panelde "publishable" anahtar da olabilir). service_role anahtarını ASLA buraya koymayın.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Yalnızca yerel tanıtım için true yapın. Gerçek kullanıcı sürümünde kapalıdır.
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
