{
  "expo": {
    "name": "Makinasal",
    "slug": "makinasal",
    "scheme": "makinasal",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "En yakın çekicileri göstermek için konumun kullanılır. Konum sunucuya kaydedilmez."
        }
      ],
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "tr.com.makinasal.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      },
      "associatedDomains": [
        "applinks:makinasal.com",
        "applinks:www.makinasal.com"
      ]
    },
    "android": {
      "package": "tr.com.makinasal.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#1F201C"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "makinasal.com",
              "pathPrefix": "/ilanlar"
            },
            {
              "scheme": "https",
              "host": "makinasal.com",
              "pathPrefix": "/magaza"
            },
            {
              "scheme": "https",
              "host": "makinasal.com",
              "pathPrefix": "/firmalar"
            },
            {
              "scheme": "https",
              "host": "makinasal.com",
              "pathPrefix": "/is-agi"
            },
            {
              "scheme": "https",
              "host": "www.makinasal.com",
              "pathPrefix": "/ilanlar"
            },
            {
              "scheme": "https",
              "host": "www.makinasal.com",
              "pathPrefix": "/magaza"
            },
            {
              "scheme": "https",
              "host": "www.makinasal.com",
              "pathPrefix": "/firmalar"
            },
            {
              "scheme": "https",
              "host": "www.makinasal.com",
              "pathPrefix": "/is-agi"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "icon": "./assets/brand/icon.png",
    "splash": {
      "image": "./assets/brand/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EDE5D6"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0a639b03-9ba8-45a2-b6d2-dda84646cf68"
      }
    },
    "owner": "komutanlogar0982",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0a639b03-9ba8-45a2-b6d2-dda84646cf68",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
