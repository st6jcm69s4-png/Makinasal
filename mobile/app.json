{
  "expo": {
    "name": "Makinasal",
    "slug": "makinasal",
    "scheme": "makinasal",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "En yakın çekicileri göstermek için konumun kullanılır. Konum sunucuya kaydedilmez."
        }
      ],
      "expo-apple-authentication",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "tr.com.makinasal.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "tr.com.makinasal.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#0D7468"
      }
    },
    "icon": "./assets/brand/icon.png",
    "splash": {
      "image": "./assets/brand/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EDE5D6"
    }
  }
}
